# Copy this file to .env.local and fill in what you need.
# Never commit real keys.

# --- Contact form delivery ---
# Set at least one provider. Without one, /api/contact returns 503 rather than
# pretending the message was delivered.

# Resend (https://resend.com) — recommended for a simple inbox.
RESEND_API_KEY=
# Where enquiries are sent.
CONTACT_TO_EMAIL=contact@agentack.co
# A verified sender on your Resend domain.
CONTACT_FROM_EMAIL="Agentack website <website@agentack.co>"

# HubSpot Forms API — optional, useful if enquiries should land in the CRM.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=

# --- Booking ---
# Cal.com path, for example "agentack/discovery".
# Leave empty to hide the calendar and use the form as the only path.
NEXT_PUBLIC_CALCOM_LINK=
